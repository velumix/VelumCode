{
  "name": "velum-code",
  "private": true,
  "version": "0.7.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:sdk": "node --test tests/plugin-sdk.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "check": "npm run build && npm test && npm run test:sdk && npm run test:rust",
    "check:extensions": "cargo build --manifest-path src-tauri/Cargo.toml && node scripts/extensions-smoke.mjs",
    "check:native": "cargo build --manifest-path src-tauri/Cargo.toml && node scripts/native-smoke.mjs",
    "check:tools": "cargo build --manifest-path src-tauri/Cargo.toml && node scripts/agent-tools-smoke.mjs",
    "check:tools:native": "cargo build --manifest-path src-tauri/Cargo.toml && node scripts/agent-tools-smoke.mjs --native",
    "check:provider-mcp": "node scripts/provider-mcp-config-smoke.mjs",
    "check:remote": "npm run build && cargo build --manifest-path src-tauri/Cargo.toml && node scripts/remote-smoke.mjs",
    "tauri": "tauri",
    "check:bots": "cargo build --manifest-path src-tauri/Cargo.toml && node scripts/bots-smoke.mjs",
    "legal:notices": "node scripts/legal-notices.mjs",
    "legal:notices:check": "node scripts/legal-notices.mjs --check",
    "legal:check": "node scripts/legal-check.mjs",
    "legal:release": "node scripts/legal-check.mjs --release"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
