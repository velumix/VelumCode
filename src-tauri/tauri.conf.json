{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velum Code",
  "version": "0.7.3",
  "identifier": "com.velumix.musecode",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Velum Code",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false,
        "backgroundColor": "#18191b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "icons/128x128.png": "velum-notification.png",
      "../LEGAL.md": "legal/LEGAL.md",
      "../PRIVACY.md": "legal/PRIVACY.md",
      "../SECURITY.md": "legal/SECURITY.md",
      "../TERMS.md": "legal/TERMS.md",
      "../THIRD_PARTY_NOTICES.txt": "legal/THIRD_PARTY_NOTICES.txt",
      "../legal/covered-sources/README.md": "legal/covered-sources/README.md",
      "../legal/covered-sources/cssparser-0.36.0.crate": "legal/covered-sources/cssparser-0.36.0.crate",
      "../legal/covered-sources/cssparser-macros-0.6.1.crate": "legal/covered-sources/cssparser-macros-0.6.1.crate",
      "../legal/covered-sources/dtoa-short-0.3.5.crate": "legal/covered-sources/dtoa-short-0.3.5.crate",
      "../legal/covered-sources/nsis-3.11-src.tar.bz2": "legal/covered-sources/nsis-3.11-src.tar.bz2",
      "../legal/covered-sources/option-ext-0.2.0.crate": "legal/covered-sources/option-ext-0.2.0.crate",
      "../legal/covered-sources/selectors-0.36.1.crate": "legal/covered-sources/selectors-0.36.1.crate",
      "../legal/dependencies.json": "legal/dependencies.json",
      "../legal/upstream.json": "legal/upstream.json",
      "../legal/upstream/MPL-2.0.txt": "legal/upstream/MPL-2.0.txt",
      "../legal/upstream/NSIS-COPYING.txt": "legal/upstream/NSIS-COPYING.txt",
      "../legal/upstream/NSIS-Modern-UI-2-License.txt": "legal/upstream/NSIS-Modern-UI-2-License.txt",
      "../legal/upstream/NSISdl-License.txt": "legal/upstream/NSISdl-License.txt",
      "../legal/upstream/alloc-stdlib-LICENSE": "legal/upstream/alloc-stdlib-LICENSE",
      "../legal/upstream/defmt-parser-LICENSE-APACHE": "legal/upstream/defmt-parser-LICENSE-APACHE",
      "../legal/upstream/defmt-parser-LICENSE-MIT": "legal/upstream/defmt-parser-LICENSE-MIT",
      "../legal/upstream/serial-LICENSE": "legal/upstream/serial-LICENSE",
      "../legal/upstream/tauri-plugin-LICENSE_MIT": "legal/upstream/tauri-plugin-LICENSE_MIT",
      "../legal/upstream/unic-LICENSE-APACHE": "legal/upstream/unic-LICENSE-APACHE",
      "../legal/upstream/unic-LICENSE-MIT": "legal/upstream/unic-LICENSE-MIT",
      "../legal/upstream/unic-ucd-ident-LICENSE-APACHE": "legal/upstream/unic-ucd-ident-LICENSE-APACHE",
      "../legal/upstream/unic-ucd-ident-LICENSE-MIT": "legal/upstream/unic-ucd-ident-LICENSE-MIT",
      "../legal/upstream/webview2-SDK-LICENSE.txt": "legal/upstream/webview2-SDK-LICENSE.txt",
      "../legal/upstream/webview2-SDK-NOTICE.txt": "legal/upstream/webview2-SDK-NOTICE.txt",
      "../legal/upstream/webview2-com-LICENSE": "legal/upstream/webview2-com-LICENSE",
      "../legal/upstream/webview2-com-macros-LICENSE": "legal/upstream/webview2-com-macros-LICENSE",
      "../legal/upstream/Rust-1.98.1-MIT.txt": "legal/upstream/Rust-1.98.1-MIT.txt",
      "../legal/upstream/Rust-1.98.1-Apache-2.0.txt": "legal/upstream/Rust-1.98.1-Apache-2.0.txt",
      "../legal/upstream/Rust-1.98.1-COPYRIGHT-library.html": "legal/upstream/Rust-1.98.1-COPYRIGHT-library.html"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "Velum Code",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installerHooks": "nsis/installer-hooks.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2MDNCRUI5OTRCNUI5NjIKUldSaXViV1V1YjRETnFCNWVDQkRnbU54THpNQm11ejRJKzRReHFpMHJZdGFGQXc2WDNxZzQ4RnQK",
      "endpoints": [
        "https://github.com/velumix/VelumCode/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
